import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';
import '../models/goal_model.dart';
import '../services/database_helper.dart';
import '../services/gamification_service.dart';
import '../theme/app_theme.dart';

class MetasScreen extends StatefulWidget {
  const MetasScreen({super.key});

  @override
  State<MetasScreen> createState() => _MetasScreenState();
}

class _MetasScreenState extends State<MetasScreen> {
  final DatabaseHelper _dbHelper = DatabaseHelper.instance;
  final GamificationService _gamif = GamificationService.instance;
  late List<Goal> _metas = [];
  bool _cargando = true;
  Set<int> _reclamadoMetas = {};

  final _tituloController = TextEditingController();
  final _descripcionController = TextEditingController();
  final _montoObjetivoController = TextEditingController();
  final _categoriaController = TextEditingController();

  @override
  void initState() {
    super.initState();
    _cargarMetas();
  }

  Future<void> _cargarMetas() async {
    try {
      final metas = await _dbHelper.getAllGoals();
      if (!mounted) return;
      setState(() {
        _metas = metas;
        _cargando = false;
      });
    } catch (e) {
      if (!mounted) return;
      setState(() => _cargando = false);
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Error al cargar metas'), backgroundColor: AppColors.yellow),
      );
    }
  }

  // Dialog simple sin showDialog complejo
  Future<bool> _mostrarDialogoCrearMetaBuildContext(BuildContext ctx) async {
    _tituloController.clear();
    _descripcionController.clear();
    _montoObjetivoController.clear();
    _categoriaController.clear();

    // Usaremos un enfoque simple con Navigator.push
    final result = await Navigator.push<bool>(
      context,
      MaterialPageRoute(
        builder: (BuildContext innerCtx) => _DialogoCrearMetaInner(
          tituloController: _tituloController,
          descripcionController: _descripcionController,
          montoObjetivoController: _montoObjetivoController,
          categoriaController: _categoriaController,
          ctx: innerCtx,
          dbHelper: _dbHelper,
        ),
      ),
    );
    if (result != null) return result;
    return false;
  }

  Future<void> _mostrarDialogoAgregarIngreso(Goal meta) async {
    final _controlMonto = TextEditingController();

    return showDialog<void>(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          title: Text(
            'Agregar Ingreso a "${meta.titulo}"',
            style: GoogleFonts.fredoka(
              fontSize: 20,
              fontWeight: FontWeight.bold,
              color: AppColors.darkBlue,
            ),
          ),
          content: SingleChildScrollView(
            child: Column(
              children: [
                TextField(
                  controller: _controlMonto,
                  decoration: InputDecoration(
                    labelText: 'Monto del ingreso (S/)',
                    labelStyle: GoogleFonts.fredoka(fontSize: 14),
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                    hintText: 'Ej: 100.00',
                  ),
                  keyboardType: TextInputType.numberWithOptions(decimal: true),
                  style: GoogleFonts.fredoka(fontSize: 14),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(context).pop(),
              child: Text(
                'Cancelar',
                style: GoogleFonts.fredoka(
                  color: AppColors.textMuted,
                ),
              ),
            ),
            ElevatedButton(
              onPressed: () async {
                final montoStr = _controlMonto.text.trim();
                if (montoStr.isEmpty) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text('Por favor ingrese un monto'),
                      backgroundColor: AppColors.yellow,
                    ),
                  );
                  return;
                }

                final monto = double.parse(montoStr);

                final metaActualizada = meta.copyWith(
                  montoActual: meta.montoActual + monto,
                );

                await _dbHelper.updateGoal(metaActualizada);

                // Si la meta se completÃ³ por este ingreso, SOLO actualizamos el progreso
                // No otorgamos hormigasoles automÃ¡ticamente - el usuario debe reclamarlos
                // con el botÃ³n "Reclamar Hormigasoles" que aparece en la tarjeta de la meta
                if (metaActualizada.estaCompleta) {
                  await _cargarMetas();
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        'Meta completada! Progreso: ${metaActualizada.progresoString}',
                        style: GoogleFonts.fredoka(color: AppColors.textDark),
                      ),
                      backgroundColor: AppColors.softTeal,
                    ),
                  );
                } else {
                  await _cargarMetas();
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        'Ingreso de S/ $monto agregado. Progreso: ${metaActualizada.progresoString}',
                        style: GoogleFonts.fredoka(color: AppColors.textDark),
                      ),
                      backgroundColor: AppColors.softTeal,
                    ),
                  );
                }

                // Cerrar el diÃ¡logo y limpiar el campo
                Navigator.of(context).pop();
                _controlMonto.clear();
              },
              child: Text(
                'Agregar',
                style: GoogleFonts.fredoka(
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ],
        );
      },
    );
  }

  int _calcularHormigasolesPremio(double montoObjetivo) {
    final base = (montoObjetivo / 10).floor();
    return base.clamp(5, 50);
  }

  Future<void> _eliminarMeta(Goal meta) async {
    await _dbHelper.deleteGoal(meta.id!);
    await _cargarMetas();
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('Meta eliminada'),
        backgroundColor: AppColors.yellow,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(
          'Mis Metas',
          style: GoogleFonts.fredoka(
            fontSize: 22,
            fontWeight: FontWeight.bold,
            color: AppColors.darkBlue,
          ),
        ),
        automaticallyImplyLeading: false,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            // BotÃ³n para crear nueva meta
            ElevatedButton.icon(
              onPressed: () async {
                final creado = await _mostrarDialogoCrearMetaBuildContext(context);
                if (creado) await _cargarMetas();
              },
              style: ElevatedButton.styleFrom(
                backgroundColor: AppColors.darkBlue,
                foregroundColor: AppColors.white,
                padding: const EdgeInsets.symmetric(vertical: 14),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(16),
                ),
                elevation: 0,
              ),
              icon: const Icon(Icons.add_circle_outline),
              label: Text(
                'Crear Nueva Meta',
                style: GoogleFonts.fredoka(
                  fontWeight: FontWeight.bold,
                  fontSize: 16,
                ),
              ),
            ),
            const SizedBox(height: 20),

            // Si no hay metas o estÃ¡ cargando
            if (_cargando)
              const Center(child: CircularProgressIndicator())
            else if (_metas.isEmpty)
              // Mensaje cuando no hay metas
              Center(
                child: Column(
                  children: [
                    Icon(
                      Icons.delete,
                      size: 64,
                      color: AppColors.textMuted,
                    ),
                    const SizedBox(height: 16),
                    Text(
                      'No tienes metas aÃºn',
                      style: GoogleFonts.fredoka(
                        fontSize: 18,
                        color: AppColors.textMuted,
                      ),
                    ),
                    const SizedBox(height: 8),
                    Text(
                      'Crear tu primera meta arriba para comenzar',
                      style: GoogleFonts.fredoka(
                        fontSize: 14,
                        color: AppColors.textMuted,
                      ),
                    ),
                  ],
                ),
              )
            else
              // Mostrar lista de metas
              ListView.builder(
                shrinkWrap: true,
                physics: const NeverScrollableScrollPhysics(),
                itemCount: _metas.length,
                itemBuilder: (context, index) {
                  final meta = _metas[index];
                  final esCompleta = meta.estaCompleta;

                  return Card(
                    margin: const EdgeInsets.only(bottom: 16),
                    child: Padding(
                      padding: const EdgeInsets.all(16),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          // Header de la meta
                          Row(
                            mainAxisAlignment: MainAxisAlignment.spaceBetween,
                            children: [
                              Text(
                                meta.titulo,
                                style: GoogleFonts.fredoka(
                                  fontSize: 16,
                                  fontWeight: FontWeight.bold,
                                  color: AppColors.darkBlue,
                                ),
                              ),
                              if (esCompleta)
                                Container(
                                  padding:
                                      const EdgeInsets.symmetric(
                                          horizontal: 8, vertical: 4),
                                  decoration: BoxDecoration(
                                    color: AppColors.teal,
                                    borderRadius: BorderRadius.circular(20),
                                  ),
                                  child: Text(
                                    'Completada',
                                    style: GoogleFonts.fredoka(
                                      fontSize: 10,
                                      fontWeight: FontWeight.bold,
                                      color: AppColors.white,
                                    ),
                                  ),
                                ),
                            ],
                          ),
                          const SizedBox(height: 8),

                          // Progreso
                          Row(
                            children: [
                              Text(
                                'Progreso: ',
                                style: GoogleFonts.fredoka(
                                  fontSize: 13,
                                  color: AppColors.textMuted,
                                ),
                              ),
                              Expanded(
                child: ClipRRect(
                  borderRadius: BorderRadius.circular(8),
                  child: LinearProgressIndicator(
                    value: meta.progresoPorcentaje / 100,
                    minHeight: 8,
                    backgroundColor: AppColors.softTeal,
                    valueColor: AlwaysStoppedAnimation<Color>(
                      esCompleta ? AppColors.teal : AppColors.darkBlue,
                    ),
                  ),
                ),
              ),
                            ],
                          ),
                          const SizedBox(height: 4),

                          // Monto actual / objetivo
                          Text(
                            '${meta.progresoFormato}',
                            style: GoogleFonts.fredoka(
                              fontSize: 14,
                              color: AppColors.darkBlue,
                            ),
                          ),

                          // DescripciÃ³n y categorÃ­a
                          Text(
                            meta.descripcion.isNotEmpty
                                ? meta.descripcion
                                : 'Sin descripciÃ³n',
                            style: GoogleFonts.fredoka(
                              fontSize: 12,
                              color: AppColors.textMuted,
                            ),
                          ),
                          const SizedBox(height: 4),

                          // Si la meta NO estÃ¡ completada: mostrar campo para agregar ingreso
                          if (!esCompleta)
                            ElevatedButton.icon(
                              onPressed: () => _mostrarDialogoAgregarIngreso(meta),
                              style: ElevatedButton.styleFrom(
                                backgroundColor: AppColors.softTeal,
                                foregroundColor: AppColors.darkBlue,
                                padding: const EdgeInsets.symmetric(
                                    vertical: 8, horizontal: 12),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(10),
                                ),
                                elevation: 0,
                              ),
                              icon: const Icon(Icons.arrow_upward_rounded,
                                  size: 18),
                              label: Text(
                                'Agregar Ingreso',
                                style: GoogleFonts.fredoka(
                                    fontSize: 12, fontWeight: FontWeight.w500),
                              ),
                            )
                          // Si la meta SÃ estÃ¡ completada: mostrar botÃ³n reclamar
                          else
                            ElevatedButton.icon(
                              onPressed: () {
if (_reclamadoMetas.contains(meta.id)) {
                                  ScaffoldMessenger.of(context).showSnackBar(
                                    const SnackBar(
                                      content: Text('Ya has reclamado hormigasoles en esta meta'),
                                      backgroundColor: AppColors.yellow,
                                    ),
                                  );
                                  return;
                                }
                                final hormigasolesPremio = _calcularHormigasolesPremio(meta.montoObjetivo);
                                await _gamif.ganarHormigasoles(hormigasolesPremio, motivo: 'Meta completada');
                                _reclamadoMetas.add(meta.id);
                                ScaffoldMessenger.of(context).showSnackBar(
                                  SnackBar(
                                    content: Column(
                                      mainAxisSize: MainAxisSize.min,
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        Text(
                                          'Â¡Hormigasoles reclamados! ðŸŽ‰',
                                          style: GoogleFonts.fredoka(
                                            fontWeight: FontWeight.bold,
                                            color: AppColors.teal,
                                          ),
                                        ),
                                        SizedBox(height: 4),
                                        Text(
                                          'Has reclamado ${hormigasolesPremio} hormigasoles por completar "${meta.titulo}"',
                                          style: GoogleFonts.fredoka(color: AppColors.textDark),
                                        ),
                                      ],
                                    ),
                                    behavior: SnackBarBehavior.floating,
                                    backgroundColor: AppColors.softTeal,
                                    duration: const Duration(seconds: 4),
                                  ),
                                );
                                // Cambiar el botÃ³n a "Reclamado" despuÃ©s de hacer clic
                                // Note: setState needed to update UI, but we can disable the button
                              },
                              style: ElevatedButton.styleFrom(
                                backgroundColor: _reclamadoMetas.contains(meta.id) ? AppColors.grey : AppColors.teal,
                                foregroundColor: AppColors.white,
                                padding: const EdgeInsets.symmetric(
                                    vertical: 12, horizontal: 20),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(16),
                                ),
                                elevation: 0,
                              ),
                              icon: _reclamadoMetas.contains(meta.id)
                                    ? Icon(Icons.check_circle, color: AppColors.teal)
                                    : const Icon(Icons.remove_circle_outlined),
label: _reclamadoMetas.contains(meta.id)
                                    ? Text(
                                        'Reclamado',
                                        style: GoogleFonts.fredoca(
                                          fontWeight: FontWeight.bold,
                                        ),
                                      )
                                    : Text(
                                        'Reclamar Hormigasoles',
                                        style: GoogleFonts.fredoca(
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                              ),
                            ),
                        ],
                      ),
                    ),
                  );
                },
              ),
          ],
        ),
      ),
    );
  }
}

// DiÃ¡logo interno para crear meta
class _DialogoCrearMetaInner extends StatefulWidget {
  final TextEditingController tituloController;
  final TextEditingController descripcionController;
  final TextEditingController montoObjetivoController;
  final TextEditingController categoriaController;
  final BuildContext ctx;
  final DatabaseHelper dbHelper;

  _DialogoCrearMetaInner({
    required this.tituloController,
    required this.descripcionController,
    required this.montoObjetivoController,
    required this.categoriaController,
    required this.ctx,
    required this.dbHelper,
  });

  @override
  State<_DialogoCrearMetaInner> createState() => _DialogoCrearMetaInnerState();
}

class _DialogoCrearMetaInnerState extends State<_DialogoCrearMetaInner> {
  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: Text('Crear Nueva Meta', style: GoogleFonts.fredoka(fontSize: 20, fontWeight: FontWeight.bold, color: AppColors.darkBlue)),
      content: SingleChildScrollView(
        child: Column(children: [
          TextField(controller: widget.tituloController, decoration: InputDecoration(labelText: 'TÃ­tulo de la meta', labelStyle: GoogleFonts.fredoka(fontSize: 14), border: OutlineInputBorder(borderRadius: BorderRadius.circular(12))), style: GoogleFonts.fredoka(fontSize: 14)),
          const SizedBox(height: 12),
          TextField(controller: widget.descripcionController, decoration: InputDecoration(labelText: 'DescripciÃ³n (opcional)', labelStyle: GoogleFonts.fredoka(fontSize: 14), border: OutlineInputBorder(borderRadius: BorderRadius.circular(12))), style: GoogleFonts.fredoka(fontSize: 14), maxLines: 2),
          const SizedBox(height: 12),
          TextField(controller: widget.montoObjetivoController, decoration: InputDecoration(labelText: 'Monto objetivo (S/)', labelStyle: GoogleFonts.fredoka(fontSize: 14), border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)), hintText: 'Ej: 500.00'), style: GoogleFonts.fredoka(fontSize: 14), keyboardType: TextInputType.numberWithOptions(decimal: true)),
          const SizedBox(height: 12),
          TextField(controller: widget.categoriaController, decoration: InputDecoration(labelText: 'CategorÃ­a (ej: ahorro, viaje)', labelStyle: GoogleFonts.fredoka(fontSize: 14), border: OutlineInputBorder(borderRadius: BorderRadius.circular(12))), style: GoogleFonts.fredoka(fontSize: 14)),
        ]),
      ),
      actions: [
        TextButton(onPressed: () => Navigator.of(context).pop(false), child: Text('Cancelar', style: GoogleFonts.fredoka(color: AppColors.textMuted))),
        ElevatedButton(onPressed: () async {
          final t = widget.tituloController.text.trim();
          final d = widget.descripcionController.text.trim();
          final mS = widget.montoObjetivoController.text.trim();
          final c = widget.categoriaController.text.trim();
          if (t.isEmpty || mS.isEmpty) {
            Navigator.of(context).pop(false);
            return;
          }
          final mO = double.parse(mS);
          final meta = Goal(titulo: t, descripcion: d, montoObjetivo: mO, montoActual: 0.0, categoria: c.isNotEmpty ? c : 'general');
          try {
            await widget.dbHelper.insertGoal(meta);
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(content: Text('${meta.titulo} creada exitosamente'), backgroundColor: AppColors.teal),
            );
            Navigator.of(context).pop(true);
          } catch (_) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Error al crear la meta'), backgroundColor: AppColors.yellow),
            );
            Navigator.of(context).pop(false);
          }
        }, child: Text('Crear', style: GoogleFonts.fredoka(fontWeight: FontWeight.bold)))
      ],
    );
  }
}
